# Security headers for every page and file the site serves (Cloudflare Workers static assets
# read this file; it is not served itself).
#
# Content-Security-Policy lists the only places the page may load code, styles, fonts, images,
# video and data from. Anything else (for example a script injected through a post) is blocked.
# - script-src: the app itself, the pinned Supabase client on jsDelivr, and the small theme
#   script at the top of index.html (by its hash: if that script changes, update the hash).
# - style-src 'unsafe-inline' is needed for the style="" attributes in index.html.
# - img-src / media-src: blob: is the preview of a photo or video picked in the composer.
# - static.cloudflareinsights.com / cloudflareinsights.com: Cloudflare Web Analytics, if it is on.
# - frame-ancestors 'none': no other site can show Sanad inside a frame (clickjacking).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://static.cloudflareinsights.com 'sha256-uiR9lqt8KjMcHVM77wvhh0qVm+W56Q2TGi949hFqp9Q='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://api.thesannad.com; media-src 'self' blob: https://api.thesannad.com; connect-src 'self' https://api.thesannad.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
